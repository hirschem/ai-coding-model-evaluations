diff --git a/components/lib/confirmpopup/ConfirmPopup.spec.js b/components/lib/confirmpopup/ConfirmPopup.spec.js
new file mode 100644
index 000000000..c61aefb24
--- /dev/null
+++ b/components/lib/confirmpopup/ConfirmPopup.spec.js
@@ -0,0 +1,72 @@
+import '@testing-library/jest-dom';
+import { fireEvent, render, screen, waitFor } from '@testing-library/react';
+import React, { useState } from 'react';
+import { PrimeReactProvider } from '../api/Api';
+import { Button } from '../button/Button';
+import { ConfirmPopup } from './ConfirmPopup';
+
+describe('ConfirmPopup', () => {
+    const TestComponent = ({ onHide, dismissable = true }) => {
+        const [visible, setVisible] = useState(false);
+        const [target, setTarget] = useState(null);
+
+        return (
+            <PrimeReactProvider value={{ cssTransition: false }}>
+                <Button
+                    data-testid="target-btn"
+                    label="Confirm"
+                    onClick={(e) => {
+                        setTarget(e.currentTarget);
+                        setVisible(true);
+                    }}
+                />
+                <Button data-testid="outside-btn" label="Outside" />
+                <ConfirmPopup
+                    target={target}
+                    visible={visible}
+                    onHide={() => {
+                        setVisible(false);
+                        onHide && onHide();
+                    }}
+                    dismissable={dismissable}
+                    message="Are you sure?"
+                />
+            </PrimeReactProvider>
+        );
+    };
+
+    test('closes on the first click outside after interacting inside the popup', async () => {
+        const onHide = jest.fn();
+        render(<TestComponent onHide={onHide} />);
+
+        // Open ConfirmPopup
+        fireEvent.click(screen.getByTestId('target-btn'));
+        await waitFor(() => expect(screen.getByText('Are you sure?')).toBeInTheDocument());
+        await new Promise((r) => setTimeout(r, 50));
+
+        // Click inside the popup (e.g. message element)
+        fireEvent.click(screen.getByText('Are you sure?'));
+        expect(screen.getByText('Are you sure?')).toBeInTheDocument();
+        expect(onHide).not.toHaveBeenCalled();
+
+        // Click outside the popup - should close on the first click
+        fireEvent.click(screen.getByTestId('outside-btn'));
+        await waitFor(() => expect(screen.queryByText('Are you sure?')).not.toBeInTheDocument());
+        expect(onHide).toHaveBeenCalledTimes(1);
+    });
+
+    test('closes on the first click outside when no interaction inside happened', async () => {
+        const onHide = jest.fn();
+        render(<TestComponent onHide={onHide} />);
+
+        // Open ConfirmPopup
+        fireEvent.click(screen.getByTestId('target-btn'));
+        await waitFor(() => expect(screen.getByText('Are you sure?')).toBeInTheDocument());
+        await new Promise((r) => setTimeout(r, 50));
+
+        // Click outside directly
+        fireEvent.click(screen.getByTestId('outside-btn'));
+        await waitFor(() => expect(screen.queryByText('Are you sure?')).not.toBeInTheDocument());
+        expect(onHide).toHaveBeenCalledTimes(1);
+    });
+});
